# Abacus RouteLLM API credential. Do not commit a real key.
ABACUSAI_GS_EBS_BRAIN_KEY=replace-with-your-key

# Set these to exact, currently available model IDs from GET /v1/models.
# The router only sends these configured model IDs upstream.
ROUTER_CHEAP_MODEL=replace-with-approved-model-id
ROUTER_STRONG_MODEL=replace-with-approved-model-id

# Optional local listener settings.
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8000
ROUTELLM_BASE_URL=https://routellm.abacus.ai/v1
