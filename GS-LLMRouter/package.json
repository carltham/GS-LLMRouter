{
  "name": "gsaccount-llm-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run --config ../dev/testing/vitest/vitest.config.ts",
    "test:watch": "vitest --config ../dev/testing/vitest/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ../dev/testing/vitest/vitest.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  }
}
